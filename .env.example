TELEGRAM_BOT_TOKEN=
# Run a local Bot API server to lift the 20 MB download cap to 2 GB.
# See: https://github.com/tdlib/telegram-bot-api
# Leave empty to use the default hosted API (20 MB limit).
LOCAL_BOT_API_URL=
# Telegram polling and HTTP transport timeouts (seconds).
# The effective getUpdates read deadline is POLL + GET_UPDATES_READ (25s here).
TELEGRAM_POLL_TIMEOUT_SECONDS=10
TELEGRAM_GET_UPDATES_READ_TIMEOUT_SECONDS=15
TELEGRAM_API_CONNECT_TIMEOUT_SECONDS=10
TELEGRAM_API_READ_TIMEOUT_SECONDS=30
TELEGRAM_API_WRITE_TIMEOUT_SECONDS=30
TELEGRAM_API_POOL_TIMEOUT_SECONDS=5
TELEGRAM_API_MEDIA_WRITE_TIMEOUT_SECONDS=600
# Exit status 75 after this long without a completed getUpdates so a supervisor
# can restart the process. Set to 0 to disable (not recommended).
TELEGRAM_POLL_WATCHDOG_TIMEOUT_SECONDS=120
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
MAX_VIDEO_DURATION_SECONDS=0
# Transcription backend: local, api, or mlx
WHISPER_BACKEND=local
# Whisper API backend (Ollama or any OpenAI-compatible endpoint,
# e.g. Groq: WHISPER_API_URL=https://api.groq.com/openai WHISPER_API_MODEL=whisper-large-v3-turbo)
WHISPER_API_URL=http://localhost:11434
WHISPER_API_MODEL=karanchopda333/whisper
# Bearer token for hosted Whisper APIs; leave empty for local servers
WHISPER_API_KEY=
# MLX backend model. Requires Apple Silicon and mlx-audio.
MLX_ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
MLX_ASR_MODEL_DIR=models/Qwen3-ASR-1.7B-8bit
MLX_ASR_CHUNK_DURATION_SECONDS=30
MLX_ASR_MAX_TOKENS=4096
MLX_ASR_PREFILL_STEP_SIZE=512
